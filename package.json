{
  "name": "@shared/pg-boss-manager",
  "version": "1.0.0",
  "description": "Lenvora shared pg-boss job queue manager",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beartrando/pg-boss-manager.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.12.0"
  },
  "dependencies": {
    "pg-boss": "^12.15.0",
    "@shared/logger": "workspace:*",
    "@shared/kafka-manager": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@11.28.4"
}
